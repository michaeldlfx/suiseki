{
  "name": "suiseki",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "scripts/build.sh bin/suiseki",
    "build:release": "scripts/build-release.sh",
    "start": "./bin/suiseki",
    "clean": "rm -rf bin dist coverage",
    "test": "bun test --pass-with-no-tests",
    "format": "biome format --write .",
    "check": "tsc --noEmit && biome check --write .",
    "check:ci": "tsc --noEmit && biome ci ."
  },
  "dependencies": {
    "@pierre/diffs": "1.1.22",
    "@pierre/theme": "0.0.29",
    "ansis": "4.3.0",
    "arktype": "2.2.0",
    "diff": "8.0.3",
    "shiki": "4.0.2",
    "smol-toml": "1.6.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@biomejs/biome": "2.4.6"
  },
  "peerDependencies": {
    "typescript": "5.9.3"
  },
  "version": "0.2.0"
}
